{
  "name": "wenlan-app",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "dev:daemon": "node scripts/run-bash.mjs scripts/dev-runtime.sh start",
    "dev:all": "node scripts/run-bash.mjs scripts/dev-all.sh",
    "build": "tsc -b && vite build",
    "dev:review:web": "vite --mode review --config vite.review.config.ts",
    "build:review:web": "vite build --mode review --config vite.review.config.ts",
    "review:build": "pnpm tauri build --debug --bundles app --features review-fixtures --config app/tauri.review.conf.json --no-sign",
    "review:verify": "node scripts/verify-review-bundle.mjs",
    "review:open": "node scripts/open-review-app.mjs",
    "review": "pnpm review:build && pnpm review:verify && pnpm review:open",
    "prepare:sidecars": "node scripts/run-bash.mjs scripts/prepare-sidecars.sh",
    "prepare:sidecars:tauri-build": "node scripts/run-bash.mjs scripts/prepare-tauri-build-sidecars.sh",
    "build:daemon": "pnpm prepare:sidecars",
    "build:all": "pnpm build:daemon && pnpm build",
    "build:app:local": "pnpm tauri build --bundles app --config app/tauri.local-bundle.conf.json",
    "refactor:api-routes": "node scripts/refactor/api-route-diff.mjs",
    "release:daemon": "node scripts/run-bash.mjs scripts/prepare-sidecars.sh --release --force-build",
    "release": "pnpm clean:release && pnpm release:daemon && CXXFLAGS='-std=c++17' pnpm tauri build",
    "release:dmg": "rm -f target/release/bundle/macos/rw.*.dmg && mkdir -p target/release/bundle/dmg && node -e \"const v=require('./package.json').version; const f='target/release/bundle/dmg/Wenlan_'+v+'_aarch64.dmg'; require('fs').rmSync(f,{force:true}); const {execSync}=require('child_process'); execSync('hdiutil create -volname Wenlan -srcfolder target/release/bundle/macos -ov -format UDZO '+f,{stdio:'inherit'}); console.log('Created',f);\"",
    "clean:dev": "node scripts/run-bash.mjs scripts/dev-runtime.sh stop",
    "clean:release": "rm -f target/release/bundle/macos/rw.*.dmg; rm -rf target/release/bundle/dmg/Wenlan_*.dmg target/release/bundle/dmg/Origin_*.dmg; echo 'Release artifacts cleaned'",
    "clean:all": "pnpm clean:dev && pnpm clean:release && echo 'All cleaned'",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "postinstall": "node scripts/install-git-hooks.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:review": "playwright test --config playwright.review.config.ts",
    "test:i18n": "vitest run src/i18n/locales.test.ts src/i18n/resources.test.ts src/i18n/index.test.ts src/i18n/hardcodedCopyGuard.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && cd app && cargo test",
    "test:coverage:all": "pnpm test:coverage && cd app && cargo llvm-cov --html"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/highlight": "1.2.3",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xyflow/react": "12.11.2",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "i18next": "^26.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5",
    "sigma": "3.0.3",
    "sonner": "^2.0.7",
    "tauri-plugin-clipboard-x-api": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^28.1.0",
    "react-grab": "^0.1.48",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/7xuanlu/wenlan-app"
  }
}
